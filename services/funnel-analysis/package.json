{
  "name": "@funnel/funnel-analysis",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --env-file=../../.env --import=tsx src/index.ts",
    "start": "node --import=tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import=tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@funnel/config": "1.0.0",
    "@funnel/database": "1.0.0",
    "@funnel/logger": "1.0.0",
    "@funnel/shared": "1.0.0",
    "@funnel/types": "1.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}


